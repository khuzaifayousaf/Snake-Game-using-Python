"""
2D Snake Game in Python (pygame)

Install:  pip install pygame
Run:      python snake.py

Controls:
    Arrow keys / WASD  - move
    P                  - pause / resume
    R or SPACE         - restart after game over
    ESC                - quit
"""
import subprocess
import sys

subprocess.check_call([sys.executable, "-m", "pip", "install", "pygame"])
print("pygame installed successfully!")

import random
import sys

import pygame

# ---------- Settings ----------
CELL = 20                      # size of one grid cell in pixels
COLS, ROWS = 30, 24            # grid size
WIDTH, HEIGHT = COLS * CELL, ROWS * CELL
HUD_HEIGHT = 40                # score bar at the top
START_FPS = 8                  # starting speed
MAX_FPS = 20                   # speed cap

# Colors
BG = (18, 18, 24)
GRID = (28, 28, 38)
SNAKE_HEAD = (80, 220, 120)
SNAKE_BODY = (50, 170, 90)
FOOD = (240, 70, 70)
TEXT = (235, 235, 240)
HUD_BG = (10, 10, 14)

UP, DOWN, LEFT, RIGHT = (0, -1), (0, 1), (-1, 0), (1, 0)


class Snake:
    def __init__(self):
        self.reset()

    def reset(self):
        cx, cy = COLS // 2, ROWS // 2
        self.body = [(cx, cy), (cx - 1, cy), (cx - 2, cy)]  # head first
        self.direction = RIGHT
        self.grow_pending = 0

    def set_direction(self, new_dir):
        # Disallow reversing straight into yourself
        if (new_dir[0] + self.direction[0], new_dir[1] + self.direction[1]) != (0, 0):
            self.direction = new_dir

    def move(self):
        hx, hy = self.body[0]
        dx, dy = self.direction
        new_head = (hx + dx, hy + dy)
        self.body.insert(0, new_head)
        if self.grow_pending > 0:
            self.grow_pending -= 1
        else:
            self.body.pop()

    def grow(self, amount=1):
        self.grow_pending += amount

    @property
    def head(self):
        return self.body[0]

    def hit_wall(self):
        x, y = self.head
        return x < 0 or x >= COLS or y < 0 or y >= ROWS

    def hit_self(self):
        return self.head in self.body[1:]


def random_food(snake_body):
    free = [(x, y) for x in range(COLS) for y in range(ROWS) if (x, y) not in snake_body]
    return random.choice(free) if free else None


def draw_cell(surface, pos, color, inset=1):
    x, y = pos
    rect = pygame.Rect(x * CELL + inset, y * CELL + inset + HUD_HEIGHT,
                       CELL - inset * 2, CELL - inset * 2)
    pygame.draw.rect(surface, color, rect, border_radius=5)


def draw_grid(surface):
    for x in range(COLS):
        for y in range(ROWS):
            if (x + y) % 2 == 0:
                rect = pygame.Rect(x * CELL, y * CELL + HUD_HEIGHT, CELL, CELL)
                pygame.draw.rect(surface, GRID, rect)


def draw_text_center(surface, font, text, y, color=TEXT):
    img = font.render(text, True, color)
    surface.blit(img, img.get_rect(center=(WIDTH // 2, y)))


def main():
    pygame.init()
    pygame.display.set_caption("Snake")
    screen = pygame.display.set_mode((WIDTH, HEIGHT + HUD_HEIGHT))
    clock = pygame.time.Clock()

    font = pygame.font.SysFont("consolas", 22)
    big_font = pygame.font.SysFont("consolas", 48, bold=True)

    snake = Snake()
    food = random_food(snake.body)
    score = 0
    high_score = 0
    fps = START_FPS
    game_over = False
    paused = False

    # Queue of direction changes so quick key presses are not lost
    dir_queue = []

    key_map = {
        pygame.K_UP: UP, pygame.K_w: UP,
        pygame.K_DOWN: DOWN, pygame.K_s: DOWN,
        pygame.K_LEFT: LEFT, pygame.K_a: LEFT,
        pygame.K_RIGHT: RIGHT, pygame.K_d: RIGHT,
    }

    def restart():
        nonlocal snake, food, score, fps, game_over, paused, dir_queue
        snake = Snake()
        food = random_food(snake.body)
        score = 0
        fps = START_FPS
        game_over = False
        paused = False
        dir_queue = []

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    pygame.quit()
                    sys.exit()
                if game_over:
                    if event.key in (pygame.K_r, pygame.K_SPACE):
                        restart()
                    continue
                if event.key == pygame.K_p:
                    paused = not paused
                elif event.key in key_map and len(dir_queue) < 3:
                    dir_queue.append(key_map[event.key])

        if not game_over and not paused:
            # Apply the next queued direction
            if dir_queue:
                snake.set_direction(dir_queue.pop(0))

            snake.move()

            if snake.hit_wall() or snake.hit_self():
                game_over = True
                high_score = max(high_score, score)
            elif food and snake.head == food:
                snake.grow()
                score += 10
                fps = min(MAX_FPS, START_FPS + score // 50)
                food = random_food(snake.body)
                if food is None:  # board is full - you win
                    game_over = True
                    high_score = max(high_score, score)

        # ---------- Drawing ----------
        screen.fill(BG)
        draw_grid(screen)

        # HUD
        pygame.draw.rect(screen, HUD_BG, (0, 0, WIDTH, HUD_HEIGHT))
        screen.blit(font.render(f"Score: {score}", True, TEXT), (10, 8))
        hs = font.render(f"Best: {high_score}", True, TEXT)
        screen.blit(hs, (WIDTH - hs.get_width() - 10, 8))

        # Food
        if food:
            draw_cell(screen, food, FOOD, inset=3)

        # Snake
        for i, segment in enumerate(snake.body):
            draw_cell(screen, segment, SNAKE_HEAD if i == 0 else SNAKE_BODY)

        # Overlays
        if paused:
            draw_text_center(screen, big_font, "PAUSED", HEIGHT // 2 + HUD_HEIGHT)
        if game_over:
            draw_text_center(screen, big_font, "GAME OVER", HEIGHT // 2 + HUD_HEIGHT - 30, FOOD)
            draw_text_center(screen, font, "Press R or SPACE to restart",
                             HEIGHT // 2 + HUD_HEIGHT + 20)

        pygame.display.flip()
        clock.tick(fps)


if __name__ == "__main__":
    main()
